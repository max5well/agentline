# OpenAI — used to mint ephemeral Realtime client secrets
OPENAI_API_KEY=

# Supabase project. The service-role key is server-only and must never be
# exposed through NEXT_PUBLIC_* variables or committed to source control.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini — used to mint ephemeral Live API tokens (fast/local tiers).
# While unset, those tiers fall back to OpenAI gpt-realtime-2.1-mini.
GEMINI_API_KEY=

# Primary: gemini-3.1-flash-live-preview.
# Emergency rollback:
# GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025

# Development only. Never enable in a production deployment.
# APPLE_IAP_ALLOW_UNVERIFIED=1

# Agent-initiated calls (ADR-8). Create an Apple Push Notification auth key
# for the paid developer team. Keep the .p8 contents server-side; either real
# newlines or escaped \\n sequences are accepted. VoIP topics append ".voip".
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_TOPIC=dev.max5well.Agentline.voip
