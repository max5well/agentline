  "cards": [
    {
      "dot": "emerald",
      "title": "Live path",
      "items": [
        "Audio never passes through the backend; the app speaks to the provider directly",
        "Agent instructions and the memory file are loaded into the session at connect time",
        "Only the transcript is sent onward when the call ends"
      ]
    },
    {
      "dot": "violet",
      "title": "Derived data",
      "items": [
        "The summary step runs inline on call save, not as a background worker",
        "Intents and a short summary are written back onto the call row",
        "The memory file is re-distilled so the next call starts with context"
      ]
    },
    {
      "dot": "orange",
      "title": "Consumers",
      "items": [
        "Recents and the post-call summary screen read the stored call",
        "Usage totals are derived from call duration and model tier",
        "MCP handoff is an explicit opt-in push, not an automatic export"
      ]
    }
  ]
